{
  "name": "@deepwhale-cn/dsh-mcp-tools",
  "version": "0.1.0",
  "description": "一个 MCP 网关：把深鲸的文档合并、文档比对、站点体检、发版检查四个本地工具，用标准的 MCP 工具暴露给 Claude / Cursor 等任意客户端。",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dsh-mcp-tools": "bin/mcp.mjs"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/mcp.mjs",
    "test": "bash tests/run.sh"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6 <0.3.0",
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepwhale",
    "docx",
    "site-audit"
  ],
  "peerDependencies": {
    "@deepwhale-cn/dsh-doc-merge": "^0.1.0",
    "@deepwhale-cn/dsh-doc-compare": "^0.1.0",
    "@deepwhale-cn/dsh-site-audit": "^0.1.0",
    "@deepwhale-cn/dsh-release-guard": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@deepwhale-cn/dsh-doc-merge": { "optional": true },
    "@deepwhale-cn/dsh-doc-compare": { "optional": true },
    "@deepwhale-cn/dsh-site-audit": { "optional": true },
    "@deepwhale-cn/dsh-release-guard": { "optional": true }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feely0208/dsh-mcp-tools.git"
  },
  "homepage": "https://deepwhale.org.cn/plugins.html",
  "bugs": {
    "url": "https://github.com/feely0208/dsh-mcp-tools/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
